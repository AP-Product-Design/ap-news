---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ComponentCard from '../../components/ui/ComponentCard.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { slug: 'hero',         name: 'Hero',         description: 'Full-width lead unit with headline, dek, and lead media.' },
  { slug: 'feature-grid', name: 'Feature Grid', description: 'Responsive grid of feature stories with configurable columns.' },
  { slug: 'article-list', name: 'Article List', description: 'Vertical stack of article previews with headline, timestamp, and optional thumbnail.' },
  { slug: 'carousel',     name: 'Carousel',     description: 'Horizontally-scrolling media set with swipe affordances and per-item captions.' },
];
---

<SectionLayout
  title="Modules"
  section="modules"
  description="Self-contained content sections — feature layouts, carousels, and standalone page sections with defined structure."
>
  {cards.map(c => (
    <ComponentCard
      href={`${base}modules/${c.slug}/`}
      name={c.name}
      description={c.description}
    />
  ))}
</SectionLayout>
