---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ComponentCard from '../../components/ui/ComponentCard.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { slug: 'byline',       name: 'Byline',       description: 'In-article attribution block. Supports Stack, Row, and Hover layouts for 1–3 authors.' },
  { slug: 'author-bio',   name: 'Author Bio',   description: 'Expanded author card for article footers and dedicated author pages. Larger photo, full bio, and social links.' },
  { slug: 'article-card', name: 'Article Card', description: 'Composite card combining media, headline, dek, and metadata for use in feeds and grids.' },
];
---

<SectionLayout
  title="Slot Components"
  section="slot"
  description="Composite patterns built from base elements. Slot components accept structured content and render it in a defined layout."
>
  {cards.map(c => (
    <ComponentCard
      href={`${base}slot/${c.slug}/`}
      name={c.name}
      description={c.description}
    />
  ))}
</SectionLayout>
