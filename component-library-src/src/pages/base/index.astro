---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ComponentCard from '../../components/ui/ComponentCard.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { slug: 'button',     name: 'Button',     description: 'Filled, outlined, and text-link variants across enabled, hover, active, disabled, and selected states.' },
  { slug: 'input',      name: 'Input',      description: 'Text fields, textareas, and selects with label, placeholder, and error affordances.' },
  { slug: 'badge',      name: 'Badge',      description: 'Small labels for topic tags, live indicators, and status pips.' },
  { slug: 'divider',    name: 'Divider',    description: 'Horizontal and vertical rules at bold, moderate, and subtle emphasis levels.' },
  { slug: 'typography', name: 'Typography', description: 'Headings, body copy, story links, utility labels, and metadata text styles.' },
];
---

<SectionLayout
  title="Base Components"
  section="base"
  description="Atomic UI elements — buttons, inputs, badges, labels, typography, and other foundational building blocks of the Maple design system."
>
  {cards.map(c => (
    <ComponentCard
      href={`${base}base/${c.slug}/`}
      name={c.name}
      description={c.description}
    />
  ))}
</SectionLayout>
