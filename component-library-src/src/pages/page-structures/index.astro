---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ComponentCard from '../../components/ui/ComponentCard.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { slug: 'article-page',  name: 'Article Page',  description: 'Standard article template with header, byline, lead media, body, and related content rail.' },
  { slug: 'homepage',      name: 'Homepage',      description: 'Top-level layout combining lead hero, feature grid, and section rails.' },
  { slug: 'category-page', name: 'Category Page', description: 'Section landing page with topic hero, article list, and topic navigation.' },
  { slug: 'author-page',   name: 'Author Page',   description: 'Author profile page with expanded bio, story archive, and social links.' },
];
---

<SectionLayout
  title="Page Structures"
  section="page-structures"
  description="Full-page layout templates and grid systems for assembling complete views from modules and components."
>
  {cards.map(c => (
    <ComponentCard
      href={`${base}page-structures/${c.slug}/`}
      name={c.name}
      description={c.description}
    />
  ))}
</SectionLayout>
