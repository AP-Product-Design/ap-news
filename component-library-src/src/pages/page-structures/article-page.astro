---
import DetailLayout from '../../layouts/DetailLayout.astro';
import { articleVariants } from '../../data/article-fixtures';

const base = import.meta.env.BASE_URL;
---

<DetailLayout
  name="Article Page"
  section="page-structures"
  sectionLabel="Page Structures"
  description="Standard article template with header, byline, lead media, body, and related content rail."
>
  <section class="detail-section">
    <div class="detail-section-header">
      <h2 class="detail-section-title">Template prototypes</h2>
      <a href={`${base}article-redesign/compare/`}>Compare all templates</a>
    </div>
    <div class="variant-grid">
      {articleVariants.map((variant) => (
        <a class="variant-card" href={`${base}article-redesign/${variant.id}/`}>
          <span>{variant.label}</span>
          <p>{variant.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="detail-section">
    <h2 class="detail-section-title">Usage</h2>
    <p class="usage-copy">All variants use the same fixture data and reusable article components, making structural differences easier to evaluate.</p>
  </section>
</DetailLayout>

<style>
  .detail-section-title {
    font-size: var(--maple-text-x1);
    font-weight: var(--maple-font-weight-bold);
    color: var(--maple-text-primary);
    line-height: var(--maple-line-height-heading-120);
    margin-bottom: var(--maple-space-fixed-default);
    font-variation-settings: "wght" 700;
  }

  .detail-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--maple-space-fixed-default);
  }

  .detail-section-header a {
    font-size: var(--maple-text-size-fixed-sm);
    font-weight: var(--maple-font-weight-bold);
  }

  .variant-grid {
    display: grid;
    gap: var(--maple-space-fixed-default);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .variant-card {
    background: var(--maple-bg-elevated);
    border-top: var(--maple-stroke-02) solid var(--maple-border-bold);
    border-radius: var(--maple-radius-md);
    color: var(--maple-text-primary);
    display: grid;
    gap: var(--maple-space-fixed-compact);
    padding: var(--maple-space-fixed-expanded);
    text-decoration: none;
  }

  .variant-card span {
    font-size: var(--maple-text-x1);
    font-weight: var(--maple-font-weight-bold);
  }

  .variant-card p,
  .usage-copy {
    color: var(--maple-text-secondary);
    font-size: var(--maple-text-size-body-base);
    line-height: var(--maple-line-height-body);
  }

  .usage-copy {
    max-width: 64ch;
  }
</style>
