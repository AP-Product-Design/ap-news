---
/**
 * DetailLayout — shared layout for individual component detail pages.
 * Renders a breadcrumb back to the section, the component name, an
 * optional description, and slots for demo/preview content.
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  name: string;
  section: 'base' | 'slot' | 'modules' | 'page-structures';
  sectionLabel: string;
  description?: string;
}

const { name, section, sectionLabel, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionHref = `${base}${section}/`;
---

<BaseLayout title={name} section={section}>
  <header class="detail-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={sectionHref} class="breadcrumb-link">← {sectionLabel}</a>
    </nav>
    <h1 class="detail-title">{name}</h1>
    {description && <p class="detail-description">{description}</p>}
  </header>

  <div class="detail-body">
    <slot />
  </div>
</BaseLayout>

<style>
  .detail-header {
    padding-bottom: var(--maple-space-module-compact);
    border-bottom: var(--maple-stroke-01) solid var(--maple-border-subtle);
    margin-bottom: var(--maple-space-module-compact);
  }

  .breadcrumb {
    margin-bottom: var(--maple-space-fixed-default);
  }

  .breadcrumb-link {
    font-size: var(--maple-text-size-utility-md);
    font-weight: var(--maple-font-weight-medium);
    color: var(--maple-text-secondary);
    text-decoration: none;
    letter-spacing: var(--maple-letter-spacing-wide);
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--maple-text-primary);
  }

  .detail-title {
    font-size: var(--maple-text-x3);
    font-weight: var(--maple-font-weight-bold);
    color: var(--maple-text-primary);
    line-height: var(--maple-line-height-heading-120);
    letter-spacing: var(--maple-letter-spacing-tight);
    font-variation-settings: "wght" 700;
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .detail-description {
    font-size: var(--maple-text-size-body-base);
    color: var(--maple-text-secondary);
    line-height: var(--maple-line-height-body);
    max-width: 56ch;
  }

  .detail-body {
    display: flex;
    flex-direction: column;
    gap: var(--maple-space-module-compact);
  }
</style>
