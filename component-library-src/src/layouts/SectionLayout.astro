---
/**
 * SectionLayout — shared layout for the four section index pages.
 * Renders a page header + a responsive grid slot for ComponentCards.
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  section: 'base' | 'slot' | 'modules' | 'page-structures';
  description: string;
}

const { title, section, description } = Astro.props;
---

<BaseLayout title={title} section={section}>
  <header class="section-header">
    <p class="section-eyebrow">Component Library</p>
    <h1 class="section-title">{title}</h1>
    <p class="section-description">{description}</p>
  </header>

  <div class="section-grid">
    <slot />
  </div>
</BaseLayout>

<style>
  .section-header {
    padding-bottom: var(--maple-space-module-compact);
    border-bottom: var(--maple-stroke-01) solid var(--maple-border-subtle);
    margin-bottom: var(--maple-space-module-compact);
  }

  .section-eyebrow {
    font-size: var(--maple-text-size-utility-sm);
    font-weight: var(--maple-font-weight-medium);
    color: var(--maple-text-eyebrow);
    letter-spacing: var(--maple-letter-spacing-wide);
    text-transform: uppercase;
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .section-title {
    font-size: var(--maple-text-x3);
    font-weight: var(--maple-font-weight-bold);
    color: var(--maple-text-primary);
    line-height: var(--maple-line-height-heading-120);
    letter-spacing: var(--maple-letter-spacing-tight);
    font-variation-settings: "wght" 700;
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .section-description {
    font-size: var(--maple-text-size-body-base);
    color: var(--maple-text-secondary);
    line-height: var(--maple-line-height-body);
    max-width: 56ch;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--maple-space-fixed-default);
  }
</style>
