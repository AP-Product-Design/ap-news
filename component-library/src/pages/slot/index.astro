---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/slot/Byline.astro';
import AuthorBio from '../../components/slot/AuthorBio.astro';

/* ── Demo data ─────────────────────────────────────────── */

const jill = {
  name: 'By Jill Lawless',
  beat: 'AP Airlines and Travel Writer',
  affiliation: 'The Associated Press',
  bio: 'Lawless is based in London, covering top stories from the UK and beyond.',
  photoSrc: '/images/authors/jill-lawless.png',
  photoAlt: 'Jill Lawless',
};

const michelle = {
  name: 'By Michelle L. Price',
  beat: 'White House Reporter',
  affiliation: 'The Associated Press',
  bio: 'Price covers the White House and national politics.',
  photoSrc: '/images/authors/michelle-price.png',
  photoAlt: 'Michelle L. Price',
};

const stephen = {
  name: 'By Stephen Groves',
  beat: 'Congressional Reporter',
  affiliation: 'The Associated Press',
  bio: 'Groves covers Congress from Washington.',
  photoSrc: '/images/authors/stephen-groves.png',
  photoAlt: 'Stephen Groves',
};

const ts   = 'Updated 4:40 AM EST, February 2, 2026';
const lang = 'Leer en Español';
---

<BaseLayout title="Slot Components" section="slot">

  <header class="page-header">
    <p class="page-eyebrow">Component Library</p>
    <h1 class="page-title">Slot Components</h1>
    <p class="page-description">
      Composite patterns built from base elements. Slot components accept
      structured content and render it in a defined layout.
    </p>
  </header>

  <!-- ═══════════════════════════════════════════════════════
       BYLINE
  ═══════════════════════════════════════════════════════ -->
  <section class="component-section">
    <h2 class="component-name">Byline</h2>
    <p class="component-description">
      In-article attribution block. Supports Stack and Row layouts for 1–3 authors,
      plus a Hover card variant that appears when readers interact with an author name.
    </p>

    <!-- Hover interaction demo ───────────────────────────── -->
    <div class="variant-group">
      <h3 class="variant-label">Hover — Interaction demo</h3>
      <p class="variant-note">
        Hover over the author name below to trigger the Hover card.
      </p>
      <div class="hover-demo-context">
        <p class="demo-article-text">
          LONDON — The prime minister's spokesman offered no further
          comment on Thursday's announcement.
        </p>
        <div class="hover-demo-trigger-row">
          <div class="hover-trigger-wrapper" id="hover-demo">
            <span class="hover-trigger-name" tabindex="0" role="button" aria-expanded="false" aria-label="View author details for Jill Lawless">By Jill Lawless</span>
            <div class="hover-trigger-card" role="tooltip" aria-hidden="true">
              <Byline
                layout="hover"
                authors={[jill]}
                showBeat={true}
                showAffiliation={true}
                showBio={true}
                showButton={true}
                showSocialLinks={true}
              />
            </div>
          </div>
          <span class="demo-article-meta">{ts}</span>
        </div>
      </div>
    </div>

    <!-- Variant grid ────────────────────────────────────── -->
    <div class="variants-grid">

      <!-- Stack › 1 author -->
      <div class="variant-card">
        <p class="variant-tag">Stack / 1 author</p>
        <div class="variant-canvas">
          <Byline
            layout="stack"
            authors={[jill]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={true}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Stack › 2 authors -->
      <div class="variant-card">
        <p class="variant-tag">Stack / 2 authors</p>
        <div class="variant-canvas">
          <Byline
            layout="stack"
            authors={[jill, michelle]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={false}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Stack › 3 authors -->
      <div class="variant-card">
        <p class="variant-tag">Stack / 3 authors</p>
        <div class="variant-canvas">
          <Byline
            layout="stack"
            authors={[jill, michelle, stephen]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={false}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Row › 1 author -->
      <div class="variant-card">
        <p class="variant-tag">Row / 1 author</p>
        <div class="variant-canvas">
          <Byline
            layout="row"
            authors={[jill]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={true}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Row › 2 authors -->
      <div class="variant-card">
        <p class="variant-tag">Row / 2 authors</p>
        <div class="variant-canvas">
          <Byline
            layout="row"
            authors={[jill, michelle]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={false}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Row › 3 authors -->
      <div class="variant-card">
        <p class="variant-tag">Row / 3 authors</p>
        <div class="variant-canvas">
          <Byline
            layout="row"
            authors={[jill, michelle, stephen]}
            timestamp={ts}
            language={lang}
            showBeat={true}
            showAffiliation={true}
            showBio={false}
            showTimestamp={true}
            showLanguage={true}
            showPhoto={true}
          />
        </div>
      </div>

      <!-- Hover card (static) -->
      <div class="variant-card">
        <p class="variant-tag">Hover / card (static)</p>
        <div class="variant-canvas">
          <Byline
            layout="hover"
            authors={[jill]}
            showBeat={true}
            showAffiliation={true}
            showBio={true}
            showButton={true}
            showSocialLinks={true}
            showPhoto={true}
          />
        </div>
      </div>

    </div><!-- /variants-grid -->
  </section>

  <!-- ═══════════════════════════════════════════════════════
       AUTHOR BIO
  ═══════════════════════════════════════════════════════ -->
  <section class="component-section">
    <h2 class="component-name">Author Bio</h2>
    <p class="component-description">
      Expanded author card for article footers and dedicated author pages.
      Larger photo, full bio, and social links. No timestamp.
    </p>

    <div class="variants-grid variants-grid--single">

      <!-- Default -->
      <div class="variant-card">
        <p class="variant-tag">Default</p>
        <div class="variant-canvas">
          <AuthorBio
            authorName="Michelle L. Price"
            beat="AP Airlines and Travel Writer"
            bio="Price covers the White House. She previously covered the 2024 presidential campaign and politics, government and other news in New York, Nevada, Utah and Arizona. She is based in Washington."
            photoSrc="/images/authors/michelle-price.png"
            photoAlt="Michelle L. Price"
          />
        </div>
      </div>

      <!-- No beat -->
      <div class="variant-card">
        <p class="variant-tag">No beat</p>
        <div class="variant-canvas">
          <AuthorBio
            authorName="Jill Lawless"
            bio="Lawless is AP's Chief UK Correspondent, based in London."
            photoSrc="/images/authors/jill-lawless.png"
            photoAlt="Jill Lawless"
            showBeat={false}
          />
        </div>
      </div>

      <!-- No photo -->
      <div class="variant-card">
        <p class="variant-tag">No photo</p>
        <div class="variant-canvas">
          <AuthorBio
            authorName="Stephen Groves"
            beat="Congressional Reporter"
            bio="Groves covers Congress from Washington, D.C."
            showPhoto={false}
          />
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<!-- ── Hover interaction ───────────────────────────────── -->
<script>
  const wrapper = document.getElementById('hover-demo');
  const trigger = wrapper?.querySelector('.hover-trigger-name') as HTMLElement | null;
  const card    = wrapper?.querySelector('.hover-trigger-card') as HTMLElement | null;

  if (wrapper && trigger && card) {
    let hideTimer: ReturnType<typeof setTimeout>;

    const show = () => {
      clearTimeout(hideTimer);
      card.classList.add('is-visible');
      trigger.setAttribute('aria-expanded', 'true');
      card.setAttribute('aria-hidden', 'false');
    };

    const hide = () => {
      hideTimer = setTimeout(() => {
        card.classList.remove('is-visible');
        trigger.setAttribute('aria-expanded', 'false');
        card.setAttribute('aria-hidden', 'true');
      }, 120);
    };

    trigger.addEventListener('mouseenter', show);
    trigger.addEventListener('focus',      show);
    card.addEventListener('mouseenter',    () => clearTimeout(hideTimer));
    trigger.addEventListener('mouseleave', hide);
    card.addEventListener('mouseleave',    hide);
    trigger.addEventListener('blur',       hide);

    // Keyboard: Enter/Space toggles
    trigger.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.contains('is-visible') ? hide() : show();
      }
      if (e.key === 'Escape') hide();
    });
  }
</script>

<style>
  /* ── Page header ──────────────────────────────────────── */

  .page-header {
    padding-bottom: var(--maple-space-module-compact);
    border-bottom: var(--maple-stroke-01) solid var(--maple-border-subtle);
    margin-bottom: var(--maple-space-module-compact);
  }

  .page-eyebrow {
    font-size: var(--maple-text-size-utility-sm);
    font-weight: var(--maple-font-weight-medium);
    color: var(--maple-text-eyebrow);
    letter-spacing: var(--maple-letter-spacing-wide);
    text-transform: uppercase;
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .page-title {
    font-size: var(--maple-text-x3);
    font-weight: var(--maple-font-weight-bold);
    color: var(--maple-text-primary);
    line-height: var(--maple-line-height-heading-120);
    letter-spacing: var(--maple-letter-spacing-tight);
    font-variation-settings: "wght" 700;
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .page-description {
    font-size: var(--maple-text-size-body-base);
    color: var(--maple-text-secondary);
    line-height: var(--maple-line-height-body);
    max-width: 56ch;
  }

  /* ── Component section ────────────────────────────────── */

  .component-section {
    margin-bottom: var(--maple-space-module-expanded);
  }

  .component-name {
    font-size: var(--maple-text-x2);
    font-weight: var(--maple-font-weight-bold);
    font-variation-settings: "wght" 700;
    color: var(--maple-text-primary);
    line-height: var(--maple-line-height-heading-120);
    letter-spacing: var(--maple-letter-spacing-tight);
    margin-bottom: var(--maple-space-fixed-compact);
    padding-bottom: var(--maple-space-fixed-compact);
    border-bottom: var(--maple-stroke-03) solid var(--maple-brand-solid-red);
    display: inline-block;
  }

  .component-description {
    font-size: var(--maple-text-size-body-sm);
    color: var(--maple-text-secondary);
    line-height: var(--maple-line-height-body);
    max-width: 60ch;
    margin-bottom: var(--maple-space-fixed-generous);
  }

  /* ── Hover interaction demo ───────────────────────────── */

  .variant-group {
    margin-bottom: var(--maple-space-fixed-generous);
  }

  .variant-label {
    font-size: var(--maple-text-size-utility-sm);
    font-weight: var(--maple-font-weight-medium);
    color: var(--maple-text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--maple-letter-spacing-wide);
    margin-bottom: var(--maple-space-fixed-compact);
  }

  .variant-note {
    font-size: var(--maple-text-size-body-sm);
    color: var(--maple-text-secondary);
    margin-bottom: var(--maple-space-fixed-default);
  }

  .hover-demo-context {
    background: var(--maple-bg-elevated);
    border: var(--maple-stroke-01) solid var(--maple-border-subtle);
    border-radius: var(--maple-radius-md);
    padding: var(--maple-space-fixed-expanded);
    max-width: 560px;
  }

  .demo-article-text {
    font-family: var(--maple-font-family);
    font-size: var(--maple-text-size-body-base);
    line-height: var(--maple-line-height-body);
    color: var(--maple-text-primary);
    margin-bottom: var(--maple-space-fixed-default);
  }

  .hover-demo-trigger-row {
    display: flex;
    align-items: baseline;
    gap: var(--maple-space-fixed-default);
    flex-wrap: wrap;
  }

  /* Hover trigger wrapper — anchors the popup */
  .hover-trigger-wrapper {
    position: relative;
    display: inline-block;
  }

  /* Trigger text looks like a subtle link */
  .hover-trigger-name {
    font-family: var(--maple-font-family);
    font-size: var(--maple-text-size-body-sm);
    font-weight: var(--maple-font-weight-bold);
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    color: var(--maple-text-primary);
    cursor: default;
    border-bottom: var(--maple-stroke-01) dashed var(--maple-border-moderate);
    padding-bottom: 1px;
    outline: none;
  }

  .hover-trigger-name:focus-visible {
    outline: 2px solid var(--maple-link);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Popup card — hidden by default */
  .hover-trigger-card {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 50;
    min-width: 320px;
  }

  .hover-trigger-card.is-visible {
    display: block;
  }

  .demo-article-meta {
    font-family: var(--maple-font-family);
    font-size: var(--maple-text-size-metadata);
    color: var(--maple-text-secondary);
    line-height: var(--maple-line-height-body);
  }

  /* ── Variant grid ─────────────────────────────────────── */

  .variants-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--maple-space-fixed-default);
  }

  .variants-grid--single {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .variants-grid,
    .variants-grid--single {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .variants-grid,
    .variants-grid--single {
      grid-template-columns: 1fr;
    }
  }

  .variant-card {
    background: var(--maple-bg-elevated);
    border: var(--maple-stroke-01) solid var(--maple-border-subtle);
    border-radius: var(--maple-radius-md);
    overflow: hidden;
  }

  .variant-tag {
    font-size: var(--maple-text-size-utility-sm);
    font-weight: var(--maple-font-weight-medium);
    color: var(--maple-text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--maple-letter-spacing-wide);
    padding: var(--maple-space-fixed-compact) var(--maple-space-fixed-default);
    background: var(--maple-bg-tertiary);
    border-bottom: var(--maple-stroke-01) solid var(--maple-border-subtle);
  }

  .variant-canvas {
    padding: var(--maple-space-fixed-expanded);
  }
</style>
